# Copy to .env and fill in. NEVER commit the real .env.
#
# First deploy against a brand-new, empty database? Point DB_USER/DB_PASSWORD
# below at a superuser/admin connection, run `npm run db:setup` once (creates
# every table plus the least-privilege `made_app` role), THEN come back and
# switch these two to `made_app` + the password you set in that step's output.

# --- Postgres ---
# Use a least-privilege role (see database/migrations/0009_app_role.sql), NOT `postgres`.
DB_USER=made_app
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=essence_DB
# Optional pool tuning (defaults shown).
# DB_POOL_MAX=10
# DB_CONNECTION_TIMEOUT_MS=5000
# DB_IDLE_TIMEOUT_MS=30000
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_QUERY_TIMEOUT_MS=15000

# --- Auth secrets (generate with: node script_key.js) ---
# No fallback exists: the server refuses to start if these are unset, and they
# must be different from each other.
SECRET_KEY_TOKEN=
REFRESH_TOKEN_SECRET=
# Signs cookies. Required in production.
COOKIE_SECRET=

# bcrypt cost. Integer >= 12.
SALT_ROUNDS=12

# --- Runtime ---
# MUST be "production" in a real deployment (enables Secure cookies + JSON logs).
NODE_ENV=development
PORT=1234
# Comma-separated list of allowed browser origins. Required in production.
CORS_ORIGIN=http://localhost:5173
# Proxy hops to trust for client IP / rate limiting. Leave unset (trust nothing)
# for direct exposure. Behind exactly ONE proxy/LB that rewrites X-Forwarded-For,
# set to 1. Wrong values let clients spoof X-Forwarded-For and bypass rate limits.
# TRUST_PROXY=1
# pino level: trace|debug|info|warn|error
LOG_LEVEL=info
# Keep timestamps unambiguous (session expiry math assumes UTC).
TZ=UTC
